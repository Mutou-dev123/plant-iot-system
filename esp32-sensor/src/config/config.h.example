//==================================================
// 設定（ヘッダファイル）
// Wi-Fi情報やAPIのURLなど、システム全体で
// 使用する設定値を定義する
//==================================================

#ifndef CONFIG_H
#define CONFIG_H

// =========================
// デバイス識別名
// =========================

constexpr const char* DEVICE_NAME = "ESP_SAMPLE";

// =========================
// ファームウェア情報
// =========================

// ファームウェアバージョン
constexpr const char* FIRMWARE_VERSION = "1.0.0";

// =========================
// センサー設定
// =========================

// 各センサーの計測有効・無効設定
constexpr bool SENSOR_DHT_ENABLED = true;
constexpr bool SENSOR_SOIL_ENABLED = true;
constexpr bool SENSOR_LIGHT_ENABLED = true;

// =========================
// Wi-Fi設定
// =========================

struct WiFiConfig {
    const char* ssid;
    const char* password;
};

constexpr WiFiConfig WIFI_LIST[] = {
    {
        "YOUR_WIFI1_SSID",
        "YOUR_WIFI1_PASSWORD"
    },
    {
        "YOUR_WIFI2_SSID",
        "YOUR_WIFI2_PASSWORD"
    }
};

// 登録Wi-Fi数
constexpr int WIFI_COUNT =
    sizeof(WIFI_LIST) / sizeof(WIFI_LIST[0]);

// =========================
// Raspberry Pi API
// =========================

// センサーデータ送信用API
constexpr const char* API_URL =
    "http://YOUR_RASPBERRY_PI_IP:8000/api/receive";

// デバイス設定取得用API
constexpr const char* DEVICE_CONFIG_API_URL =
    "http://YOUR_RASPBERRY_PI_IP:8000/api/device_config/";

#endif

// ※ このファイルをconfig.hにコピーして使用してください。